# Environment variables for Avian FlightDeck
#
# The wallet is entirely client-side, so almost nothing needs configuring here. Copy to
# .env.local for local development. Anything prefixed NEXT_PUBLIC_ is baked into the static
# bundle at build time and is therefore public — never put a secret in this file.

# Build Environment
NODE_ENV=production

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Price API Settings (optional)
# The price lookup works unauthenticated; a key only raises the rate limit.
COINGECKO_API_KEY=your-coingecko-api-key

# Feature Flags
ENABLE_NOTIFICATIONS=true
ENABLE_PRICE_ALERTS=true

# Security Settings
# All security features are implemented client-side. Keys, mnemonics and passwords never leave
# the browser and are never sent to a server.
