    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "assert": "^2.1.0",
    "autoprefixer": "^10.4.21",
    "buffer": "^6.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "knip": "^5.62.0",
    "local-ssl-proxy": "^2.0.5",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
